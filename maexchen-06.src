; Maexchen gegen den Computer - Busch Microtronic 2090, Version 06
;
; Version 06: Bluff ohne feste Obergrenze. Luegt der Computer, dann mit 3/4 nah (1-3 Stufen
; ueber der Ansage) und mit 1/4 aus zwei Kopfwuerfen: der erste, der die Ansage schlaegt, wird
; angesagt (bis 21, etwa so oft wie als echter Wurf), sonst die nahe Luege. Alles weiter exakt
; gleich lang (Computerzug 3,4-3,6 s). Wuerfel mit Dritteln statt mod 3 (spart 10 Schritte).
;
; Version 05 (04 verworfen): feste Seiten. Links immer Spieler (Leben, eigene Zahl), rechts
; immer Computer (eigene Zahl, Leben). W liegt links (R4 R3), A rechts (R2 R1). Im Spielerzug
; ist W die Eingabe und A die Ansage des Computers; im Computerzug rechnet er in W, CANN tauscht
; W und A, so dass links die Ansage des Spielers und rechts die des Computers steht. Beim
; Aufdecken steht der echte Wurf auf der Seite des Ansagers, die andere Seite zeigt 00.
; Schluessel neu: Zehner - 3, Pasch + 7, 21 wird dadurch von selbst F (2 - 3).
;
; Version 03: ohne Flag-Kosmetik (Besitzer: Flag-LEDs verraten in 9-ms-Schritten nichts
; Erkennbares), Zeit weiter exakt gleich. Merkspeicher QH/rE/rF wird mit dem eigenen Wurf
; vorbelegt; bei Wahrheit wird QK um 4 erhoeht, so dass in den 4 Schritten keine Luege
; gemerkt wird. Am Ende immer W = Merkspeicher: keine Auswahl, kein MAS/EXRM. 10 Schritte frei.
;
; Version 02: Wahrheit und Luege des Computers dauern gleich lang. CTURN legt den eigenen Wurf
; mit MAS in MD-MF ab, geht immer 4 NEXT-Schritte ab der Ansage, merkt sich die Luege nach 1-4
; Schritten (gleich lange Zweige) und waehlt in gleich vielen Befehlen Wurf (EXRM) oder Luege.
; ROLL, SORT, KEY und GT laufen ohne datenabhaengige Verzweigung (GT: beide Wege 4 Befehle).
; Die Befehlszahl von der Taste bis zur Computeransage haengt nur von der Ansage und dem
; Entscheidungsweg ab, weder vom Wurf des Computers noch von der Luegenweite.
;
; Nur Anzeige, LEDs und Tastatur (KIN). Keine Matrix, kein Kabel, kein Userscript.
;
; Anzeige (DISP 6,0):   L  S S  K K  C
;   L    = Leben Spieler (links)          C = Leben Computer (rechts)
;   S S  = Spielerseite: dein Wurf, deine Eingabe, deine Ansage, beim Aufdecken dein Wurf
;   K K  = Computerseite: seine Ansage (die du ueberbieten musst), beim Aufdecken sein Wurf
; LEDs:  1 = du bist dran: Wurf mit A ansagen oder vorher mit 1-6 ueberschreiben
;        2 = Computer hat angesagt: A glauben (und selbst wuerfeln), B anzweifeln
;        4 = Runde verloren (du),  8 = Runde gewonnen (Computer verliert)
;        F = Level waehlen (1-9); die Anzeige zeigt dann den Spielstand
;            (gewonnene Spiele: links du, rechts Computer)
;
; Regeln: Rangfolge 31 32 41 ... 65, Pasch 11 ... 66, Maexchen 21. Eine Ansage muss die
; vorige uebertreffen. Wer zweifelt, deckt auf: Wurf mindestens so hoch wie die Ansage =
; der Zweifler verliert, sonst der Ansager. 6 Leben je Spieler, Maexchen-Runden kosten 2.
; Glaubt man einem angesagten Maexchen (Taste A), verliert man nur 1 Leben ohne Aufdecken.
; Der Verlierer beginnt die naechste Runde. Bei 0 Leben: Taste druecken, Spielstand,
; neues Spiel mit Levelwahl.
;
; Start: RESET (oder HALT NEXT 00), RUN, Level 1-9 tippen.
; Tasten mit Wartezeit (KIN) liefern den Zufall (RND-Zaehler), deshalb wuerfelt das
; Programm immer direkt nach einem Tastendruck. Die Entscheidung des Computers nutzt
; zusaetzlich den Zaehler vor der letzten Taste (U, in GETK gelesen): Y = F(U) + D(V),
; Z = E(U) + E(V). So haengt sie weder vom Computerwurf (V) noch vom Spielerwurf ab.
;
; Computer: zweifelt Maexchen immer an; sonst mit Fehlerquote EL/16 (Level 9: 0, Level 1: 15/16)
; Zufallsentscheidung (Muenzwurf), ansonsten zweifelt er Ansagen ueber 64 bzw. 65 an (gestreut) und jede
; Minimalerhoehung, wenn seine eigene vorige Ansage mindestens 51 war. Er sagt wahr an, wenn
; sein Wurf reicht, sonst luegt er 1-3 Stufen ueber der Ansage (abgelenkt: 1-4) oder, mit 1/4,
; einen Kopfwurf ueber der Ansage (zwei Versuche, bis 21).
;
; Keine verschachtelten CALLs. Der echte Wurf des Ansagers liegt in MD/ME (MAS, unsortiert), der
; Spielstand in M0 (Computer) und M5 (du); M1-M4, M6, M7 bleiben 0.

#define LC r0   ; Leben Computer (Anzeige rechts), im Levelbild: Spiele Computer
#define AL r1   ; Ansage (zu ueberbieten) Einer; im Computerzug Ansage des Spielers
#define AH r2   ; Ansage Zehner; nach CANN Ansage des Computers (rechte Seite)
#define WL r3   ; Wurf / Eingabe / Rechenwert, Einer (kleinere Ziffer), linke Seite
#define WH r4   ; Wurf / Eingabe, Zehner (groessere Ziffer)
#define LS r5   ; Leben Spieler (Anzeige links), im Levelbild: Spiele Spieler
#define PK r6   ; Schluessel der Ansage: Zehner - 3, Pasch + 7, 21 = F; 0 mit AL = 0: keine Ansage
#define CK r7   ; Schluessel von W
#define EL r8   ; Fehlerquote 0-F aus dem Level: 2 (9 - Level), Level 1 = F
#define T  r9   ; LEDs fuer GETK; PV bis CTURN: abgelenkt (1); in CTURN Merkspeicher Einer
#define QK rA   ; vorige Ansage (Schluessel), in CTURN: Bits 1-2 nahe Weite, 4 keine nahe Luege, 8 Kopfwurf suchen
#define QH rB   ; vorige Ansage Zehner (nur PV bis Entscheidung); in CTURN Merkspeicher Zehner
#define QL rC   ; vorige Ansage Einer; Zwischenspeicher in SORT und KEY
;                 rD, rE, rF: Taste, RND, Zwischenwerte; rD = Z bis CTURN, dann Schrittzaehler
;                 LS Bit 8: Schleifenzaehler der Kopfwuerfe (Leben hoechstens 6)

START:
        CLEAR
        EXRL                ; R0-R7 = Spielstand aus M0-M7 (L und C), M0-M7 = 0
        MOVI #F,T           ; LEDs: Level waehlen
LV:
        CALL GETK
        BRZ LV              ; 0 nicht erlaubt
        CMPI #9,rD
        BRC LV              ; A-F nicht erlaubt
        EXRL                ; Spielstand zurueck, R0-R7 = 0 (keine Ansage)
        MOVI #6,LS
        MOVI #6,LC
        MOVI #9,EL          ; EL = 2 (9 - Level)
        SUB rD,EL
        ADD EL,EL
        SUBC EL             ; Level 1: 16 -> F
PTURN:                      ; Spieler wuerfelt und sagt an
        CALL ROLL
        MOVI #1,T
PIN:
        CALL GETK
        BRZ PIN             ; 0 ignorieren
        CMPI #A,rD
        BRZ PANS
        CMPI #6,rD
        BRC PIN             ; 7-9, B-F ignorieren
        MOV WL,WH           ; Ziffer von rechts einschieben
        MOV rD,WL
        GOTO PIN
PANS:
        CALL SORT           ; ordnen, Schluessel, Carry = hoeher als die Ansage
        BRC PV
        GOTO PIN            ; zu niedrig: weiter eingeben
PV:                         ; gueltige Ansage des Spielers
        MOV PK,QK
        MOV AH,QH
        MOV AL,QL
        MOV CK,PK
        MOV WH,AH
        MOV WL,AL
        CMPI #F,PK
        BRZ DOUBTP          ; Maexchen: immer anzweifeln
        MOV rE,T            ; U = Zaehler vor der Taste (GETK), unabhaengig von V
        MOV rF,CK
        RND                 ; V = Zaehler nach der Taste (auch Quelle des Computerwurfs)
        ADD rD,CK           ; Y = F(U) + D(V)
        MOV T,rD
        ADD rE,rD           ; Z = E(U) + E(V)
        MOVI #0,T
        CMP CK,EL
        ADC T               ; T = 1: abgelenkt (Y < EL)
        BRZ NOE
        CMPI #7,rD          ; abgelenkt: Muenzwurf
        BRC DOUBTP
        GOTO CTURN
NOE:
        MOVI #3,CK          ; Schwelle 64-67 (Schluessel 6 - 3): ueber 64 (1/4) bzw. ueber 65 (3/4) zweifeln
        MOV rD,WL
        ANDI #3,WL
        ADDI #4,WL
        CALL GT             ; Carry: Schwelle > Ansage, Zero: gleich
        BRC NT
        BRZ NT
        GOTO DOUBTP
NT:
        SUBI #2,QK          ; eigene vorige Ansage unter 51 (Schluessel 2): kein Verdacht
        BRC CTURN
        MOV QH,WH
        MOV QL,WL
        CALL NEXT           ; W = naechster Wert nach der vorigen Ansage
        BRZ DOUBTP          ; Minimalerhoehung: anzweifeln
CTURN:                      ; Computer glaubt bzw. beginnt: wuerfelt und sagt an
        MOV rF,QK           ; nahe Luege: nach QK + 1 NEXT-Schritten merken (1-3, abgelenkt 1-4)
        ANDI #3,QK
        ADD T,QK
        SUBI #1,QK
        ADC QK
        MOV rD,T            ; Kopfwurf-Modus (1/4): Z und 6 = 6 -> QK + 8 (Bit 4: suchen)
        ANDI #6,T
        ADDI #2,T
        ANDI #8,T
        ADD T,QK
HL:                         ; zwei Kopfwuerfe; der erste ueber der Ansage wird gemerkt
        CALL ROLL           ; Carry: Kopfwurf > Ansage
        MOVI #0,QL
        SUBC QL             ; F oder 0
        AND QK,QL
        CMPI #7,QL          ; Carry: hoeher und noch suchend
        BRC HY
        MOV QH,QH           ; Gegenstueck, gleich viele Befehle
        MOV T,T
        GOTO HX
HY:
        MOV WH,QH           ; Merkspeicher QH / T = Kopfwurf
        MOV WL,T
        SUBI #4,QK          ; Bit 4 weg, Bit 3 an: gefunden, keine nahe Luege
HX:
        ADDI #8,LS          ; Bit 4 von LS (Leben <= 6) als Schleifenzaehler: zwei Durchlaeufe
        BRC HE
        GOTO HL
HE:
        CALL ROLL           ; echter Wurf (zuletzt, damit MD/ME ihn behalten); Carry: wahr
        BRC TR
        MOV QH,QH           ; Gegenstueck, gleich viele Befehle
        MOV T,T
        ANDI #7,QK          ; Luege, Kopfwurf nicht gefunden: suchen aus (QK = n)
        GOTO TX
TR:
        MOV WH,QH           ; wahr: Merkspeicher = eigener Wurf
        MOV WL,T
        ADDI #4,QK          ; keine nahe Luege (QK 4-F)
        NOP
TX:
        MOV AH,WH           ; nahe Luege immer ausrechnen, immer 4 Schritte ab der Ansage
        MOV AL,WL
        MOVI #3,rD
LP:
        CALL NEXT
        ADDI #F,QK          ; QK war 0: dieser Schritt ist die Luege
        BRC LN
        MOV WH,QH           ; Luege merken (QH, T)
        MOV WL,T
        GOTO LX
LN:
        MOV WH,WH           ; Gegenstueck, gleich viele Befehle
        MOV WL,WL
        NOP
LX:
        ADDI #F,rD
        BRC LP
CANN:                       ; Ansage = Merkspeicher; links die Ansage des Spielers, rechts des Computers
        MOV QH,WH
        MOV T,WL
        CALL KEY            ; CK = Schluessel der Ansage
        MOV CK,PK           ; Ansage des Computers ist jetzt zu ueberbieten
        MOV AH,WH
        MOV AL,WL
        MOV QH,AH
        MOV T,AL
        MOVI #2,T
CIN:
        CALL GETK
        CMPI #B,rD
        BRZ DOUBTC
        CMPI #A,rD
        BRZ CACC
        GOTO CIN
CACC:
        MOVI #1,rD
        CMPI #F,PK
        BRZ LOSEP           ; Maexchen geglaubt: 1 Leben, nicht aufdecken
        GOTO PTURN
DOUBTP:                     ; Computer zweifelt: Wurf des Spielers aufdecken (links)
        CALL SHOWR
        BRZ DPT             ; gleich: Ansage war wahr
        GOTO DPF
DPT:
        STC
DPF:                        ; Carry: Ansage war wahr
        MOVI #0,AH          ; rechte Seite 00 (MOVI laesst Carry stehen)
        MOVI #0,AL
        BRC LOSEC
LOSEP:                      ; Spieler verliert rD Leben
        SUB rD,LS
        ADC LS              ; nicht unter 0
        MOVI #4,T
        CALL GETK
        MOV LS,rF
        BRZ GOC
        GOTO NEWR           ; Carry ist 0 (KIN): Spieler beginnt
DOUBTC:                     ; Spieler zweifelt: Wurf des Computers aufdecken (rechts)
        CALL SHOWR
        BRZ DCT
        GOTO DCF
DCT:
        STC
DCF:                        ; Carry: Ansage war wahr; Wurf nach rechts, links 00
        MOV WH,AH
        MOV WL,AL
        MOVI #0,WH
        MOVI #0,WL
        BRC LOSEP
LOSEC:                      ; Computer verliert rD Leben
        SUB rD,LC
        ADC LC
        MOVI #8,T
        CALL GETK
        MOV LC,rF
        BRZ GOP
        STC                 ; Computer beginnt
NEWR:                       ; neue Runde, keine Ansage; Carry: wer beginnt
        MOVI #0,PK
        MOVI #0,AH
        MOVI #0,AL
        BRC CTURN
        GOTO PTURN
GOP:                        ; Spiel vorbei: Spielstand in M0 / M5 erhoehen
        EXRL
        ADDI #1,LS
        GOTO G2
GOC:
        EXRL
        ADDI #1,LC
G2:
        EXRL
        GOTO START

GETK:                       ; LEDs = T, Bild zeigen, Taste nach rD (Zero bei 0)
        DOT T
        DISP #6,r0
        RND                 ; U: rE, rF bleiben bis zur Entscheidung erhalten
        KIN rD
        DISOUT
        RET

SHOWR:                      ; echten Wurf aus MD/ME holen, rD = Verlust (Maexchen 2)
        EXRM
        MOV rD,WH
        MOV rE,WL
        EXRM
        MOVI #1,rD
        CMPI #E,PK
        ADC rD
        GOTO SORT

ROLL:                       ; zwei Wuerfel aus dem RND-Zaehler, merken in MD/ME; ohne Verzweigung
        RND
        MOVI #0,WL
RP:                         ; zwei Durchlaeufe: 1 + 2 g(E + F) + Bit 1 von D, dann D/E getauscht
        MOV WL,WH           ; erster Wuerfel nach WH (im ersten Durchlauf 0)
        MOV rE,CK
        ADD rF,CK
        ADC CK              ; x = E + F, Ueberlauf als +1: 1-F (je 17/256), selten 0
        CMPI #5,CK          ; g = Drittel: 0-5 -> 0, 6-A -> 1, B-F -> 2
        MOVI #0,WL
        ADC WL
        CMPI #A,CK
        ADC WL
        ADD WL,WL
        MOV rD,CK           ; + Bit 1 von D (Bit 4 haengt mit dem Drittel des anderen Wuerfels zusammen)
        SHR CK
        ADC WL
        ADDI #1,WL
        MOV rD,CK           ; D und E tauschen
        MOV rE,rD
        MOV CK,rE
        CMPI #0,WH
        BRZ RP
        MOV WH,rD
        MOV WL,rE
        MAS rD
        MAS rE
SORT:                       ; groessere Ziffer nach WH, ohne Sprung
        CMP WH,WL           ; Carry: WH < WL, tauschen
        MOVI #0,QL
        SUBC QL             ; QL = F (tauschen) oder 0
        MOV WL,CK
        SUB WH,CK
        AND QL,CK           ; CK = WL - WH oder 0
        ADD CK,WH
        SUB CK,WL
KEY:                        ; CK = WH - 3, Pasch + 7; 21 gibt 2 - 3 = F; ohne Sprung
        MOV WH,CK
        CMP WL,WH           ; Carry: WL < WH, kein Pasch
        MOVI #0,QL
        SUBC QL             ; F kein Pasch, 0 Pasch
        INV QL
        ANDI #7,QL          ; 7 bei Pasch
        ADD QL,CK
        SUBI #3,CK
GT:                         ; Carry: W > Ansage, Zero: W = Ansage; beide Wege 4 Befehle
        CMP PK,CK
        BRZ GL
        NOP
        RET
GL:
        CMP AL,WL
        RET

NEXT:                       ; W = naechsthoeherer Wert (21 bleibt 21), dann KEY und GT
        CMP WH,WL
        BRZ NP
        CMPI #2,WH
        BRZ KEY
        ADDI #1,WL
        CMP WH,WL
        BRZ NC
        GOTO KEY
NC:
        MOVI #1,WL          ; 54 -> 61, 65 -> 11
NC2:
        ADDI #1,WH
        CMPI #7,WH
        BRZ N11
        GOTO KEY
NP:
        CMPI #6,WH          ; Pasch: 11 -> 22 ... 66 -> 21
        BRZ N21
        ADDI #1,WL
        GOTO NC2
N21:
        MOVI #1,WH          ; ueber NC: WL = 1, WH = 2
        GOTO NC
N11:
        MOVI #1,WH
        GOTO KEY
